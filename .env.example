# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SmartRetail AI Backend
APP_ENV=development
LOG_LEVEL=info
API_V1_PREFIX=/api/v1

# Host port the backend is published on (inside the container it is always 8000)
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# Enable uvicorn --reload (hot reload) in the container. Keep true for local dev.
RELOAD=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=smartretail
POSTGRES_USER=smartretail
POSTGRES_PASSWORD=smartretail_dev_password
# Host/port as reachable from inside the compose network
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional: override the full async connection string instead of building from the fields above
# DATABASE_URL=postgresql+asyncpg://smartretail:smartretail_dev_password@postgres:5432/smartretail

# ── Redis ──────────────────────────────────────────────────────────────────
# Host/port as reachable from inside the compose network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Optional: override the full connection string instead of building from the fields above
# REDIS_URL=redis://redis:6379/0

# ── Build metadata (reported by /version) ─────────────────────────────────
# Injected as a Docker build ARG; leave empty outside CI.
GIT_COMMIT=
BUILD_TAG=dev
