<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>StoreSight — Operations Dashboard</title>
<style>
/* ── reset & variables ────────────────────────────────────────────────── */
:root{
  --bg:#0a0e1a;--bg2:#111827;--panel:rgba(17,24,39,.72);--panel-solid:#151d2e;
  --line:rgba(99,130,200,.15);--line2:rgba(99,130,200,.08);
  --text:#e8ecf4;--dim:#7a8db5;--muted:#4e5f82;
  --accent:#6c8cff;--accent2:#4f6fff;--accent-glow:rgba(108,140,255,.25);
  --ok:#34d399;--ok-glow:rgba(52,211,153,.2);--warn:#fbbf24;--warn-glow:rgba(251,191,36,.2);
  --bad:#f87171;--bad-glow:rgba(248,113,113,.2);
  --grad:linear-gradient(135deg,#6c8cff 0%,#a855f7 50%,#ec4899 100%);
  --grad2:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%);
  --shadow:0 4px 24px rgba(0,0,0,.35);
  --shadow-lg:0 8px 40px rgba(0,0,0,.5);
  --radius:14px;--radius-sm:10px;
  --transition:all .25s cubic-bezier(.4,0,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);
     font:14px/1.55 'Inter','Segoe UI',system-ui,-apple-system,sans-serif;
     min-height:100vh;overflow-x:hidden}

/* ── animated background ─────────────────────────────────────────────── */
body::before{content:'';position:fixed;inset:0;z-index:-1;
  background:radial-gradient(ellipse 80% 60% at 20% 10%,rgba(108,140,255,.07),transparent),
             radial-gradient(ellipse 60% 50% at 80% 90%,rgba(168,85,247,.05),transparent),
             var(--bg)}

/* ── header ──────────────────────────────────────────────────────────── */
header{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:14px;
  padding:0 24px;height:56px;
  background:rgba(10,14,26,.85);backdrop-filter:blur(20px) saturate(1.4);
  border-bottom:1px solid var(--line)}
header h1{font-size:16px;font-weight:700;letter-spacing:.3px;
  background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;white-space:nowrap}

/* ── nav ─────────────────────────────────────────────────────────────── */
nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;flex:1}
nav::-webkit-scrollbar{display:none}
nav button{background:transparent;border:1px solid transparent;color:var(--dim);
  padding:6px 14px;border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:500;
  white-space:nowrap;transition:var(--transition);position:relative}
nav button:hover{color:var(--text);background:rgba(108,140,255,.08);border-color:var(--line)}
nav button.active{color:#fff;background:linear-gradient(135deg,rgba(108,140,255,.18),rgba(168,85,247,.12));
  border-color:rgba(108,140,255,.3);box-shadow:0 0 16px rgba(108,140,255,.1)}
nav button.active::after{content:'';position:absolute;bottom:-7px;left:50%;transform:translateX(-50%);
  width:20px;height:2px;background:var(--grad);border-radius:2px}

/* ── user pill ───────────────────────────────────────────────────────── */
#who{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--dim);font-size:12px;white-space:nowrap}
#who .avatar{width:30px;height:30px;border-radius:50%;
  background:var(--grad);display:grid;place-items:center;color:#fff;font-size:11px;font-weight:700}

/* ── main ────────────────────────────────────────────────────────────── */
main{padding:20px 24px;max-width:1440px;margin:0 auto}

/* ── page transitions ────────────────────────────────────────────────── */
@keyframes fadeSlideIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.view-enter{animation:fadeSlideIn .35s cubic-bezier(.4,0,.2,1) both}

/* ── grid ────────────────────────────────────────────────────────────── */
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(320px,1fr))}
.grid-2{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(420px,1fr))}

/* ── cards ───────────────────────────────────────────────────────────── */
.card{background:var(--panel);backdrop-filter:blur(12px);
  border:1px solid var(--line);border-radius:var(--radius);
  padding:20px;transition:var(--transition);position:relative;overflow:hidden}
.card::before{content:'';position:absolute;inset:0;border-radius:var(--radius);
  background:linear-gradient(135deg,rgba(255,255,255,.02),transparent);pointer-events:none}
.card:hover{border-color:rgba(108,140,255,.2);box-shadow:0 4px 30px rgba(0,0,0,.2)}
.card.glow-accent:hover{box-shadow:0 0 30px var(--accent-glow);border-color:rgba(108,140,255,.3)}
.card.glow-ok:hover{box-shadow:0 0 30px var(--ok-glow)}
.card.glow-warn:hover{box-shadow:0 0 30px var(--warn-glow)}
.card.glow-bad:hover{box-shadow:0 0 30px var(--bad-glow)}
.card h3{margin:0 0 12px;font-size:11px;font-weight:600;color:var(--dim);
  text-transform:uppercase;letter-spacing:1px}
.card h3 .icon{margin-right:6px;opacity:.7}

/* ── stat cards ──────────────────────────────────────────────────────── */
.stat{text-align:center;padding:24px 16px}
.stat .num{font-size:42px;font-weight:700;line-height:1.1;
  background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat .num.solid{-webkit-text-fill-color:var(--text);background:none}
.stat .label{font-size:11.5px;color:var(--dim);margin-top:4px;text-transform:uppercase;letter-spacing:.8px}

/* ── tables ──────────────────────────────────────────────────────────── */
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;color:var(--muted);font-weight:500;padding:8px 10px;
  font-size:11px;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid var(--line)}
td{padding:9px 10px;border-bottom:1px solid var(--line2);transition:var(--transition)}
tr:hover td{background:rgba(108,140,255,.03)}

/* ── pills / badges ──────────────────────────────────────────────────── */
.pill{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;
  font-size:11px;font-weight:600;border:1px solid var(--line);transition:var(--transition)}
.pill.ok{color:var(--ok);border-color:rgba(52,211,153,.25);background:rgba(52,211,153,.06)}
.pill.warn{color:var(--warn);border-color:rgba(251,191,36,.25);background:rgba(251,191,36,.06)}
.pill.bad{color:var(--bad);border-color:rgba(248,113,113,.25);background:rgba(248,113,113,.06)}
.pill.dim{color:var(--dim);border-color:var(--line);background:rgba(122,141,181,.04)}
.pill.acc{color:var(--accent);border-color:rgba(108,140,255,.25);background:rgba(108,140,255,.06)}

/* ── pulse dot ───────────────────────────────────────────────────────── */
.pulse{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 currentColor}50%{box-shadow:0 0 0 5px transparent}}
.pulse.live{background:var(--ok);color:var(--ok);animation:pulse 2s ease-in-out infinite}
.pulse.warn-dot{background:var(--warn);color:var(--warn);animation:pulse 2s ease-in-out infinite}
.pulse.bad-dot{background:var(--bad);color:var(--bad);animation:pulse 1.5s ease-in-out infinite}

/* ── buttons ─────────────────────────────────────────────────────────── */
button.act{background:var(--accent);border:none;color:#fff;padding:7px 16px;
  border-radius:8px;cursor:pointer;font-size:12.5px;font-weight:600;
  transition:var(--transition);position:relative;overflow:hidden}
button.act:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(108,140,255,.3)}
button.act:active{transform:translateY(0);box-shadow:none}
button.act.ghost{background:rgba(108,140,255,.08);border:1px solid rgba(108,140,255,.2);color:var(--accent)}
button.act.ghost:hover{background:rgba(108,140,255,.15);border-color:rgba(108,140,255,.35)}
button.act.danger{background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.25);color:var(--bad)}
button.act.danger:hover{background:rgba(248,113,113,.2)}

/* ── inputs ──────────────────────────────────────────────────────────── */
input[type=text],input[type=password]{flex:1;background:rgba(0,0,0,.25);
  border:1px solid var(--line);color:var(--text);padding:10px 14px;border-radius:var(--radius-sm);
  font-size:13.5px;transition:var(--transition);outline:none}
input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}

/* ── svg map ─────────────────────────────────────────────────────────── */
svg.map{width:100%;height:auto;background:linear-gradient(180deg,#080c16,#0f1525);
  border-radius:var(--radius-sm);border:1px solid var(--line)}
svg.map polygon{transition:fill .3s ease}

/* ── pre / log ───────────────────────────────────────────────────────── */
pre.log{max-height:300px;overflow:auto;font-size:12px;background:rgba(0,0,0,.3);
  padding:14px;border-radius:var(--radius-sm);border:1px solid var(--line2);
  scrollbar-width:thin;scrollbar-color:var(--muted) transparent;
  font-family:'JetBrains Mono','Fira Code',monospace;line-height:1.6}
pre.log::-webkit-scrollbar{width:6px}
pre.log::-webkit-scrollbar-thumb{background:var(--muted);border-radius:3px}

/* ── skeleton loading ────────────────────────────────────────────────── */
@keyframes shimmer{0%{background-position:-400px 0}100%{background-position:400px 0}}
.skeleton{background:linear-gradient(90deg,var(--panel-solid) 25%,rgba(108,140,255,.05) 50%,var(--panel-solid) 75%);
  background-size:800px 100%;animation:shimmer 1.5s ease-in-out infinite;border-radius:8px}
.skel-line{height:14px;margin:8px 0;border-radius:6px}
.skel-box{height:80px;border-radius:var(--radius-sm)}

/* ── toast ───────────────────────────────────────────────────────────── */
#toasts{position:fixed;bottom:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px}
@keyframes toastIn{from{opacity:0;transform:translateX(40px) scale(.95)}to{opacity:1;transform:none}}
@keyframes toastOut{from{opacity:1;transform:none}to{opacity:0;transform:translateX(40px) scale(.95)}}
.toast{padding:12px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;
  backdrop-filter:blur(12px);border:1px solid var(--line);
  box-shadow:var(--shadow-lg);animation:toastIn .3s cubic-bezier(.4,0,.2,1) both;
  max-width:360px}
.toast.out{animation:toastOut .25s ease-in both}
.toast.success{background:rgba(52,211,153,.12);border-color:rgba(52,211,153,.3);color:var(--ok)}
.toast.error{background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.3);color:var(--bad)}
.toast.info{background:rgba(108,140,255,.12);border-color:rgba(108,140,255,.3);color:var(--accent)}

/* ── login modal ─────────────────────────────────────────────────────── */
.modal-overlay{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.6);
  backdrop-filter:blur(8px);display:grid;place-items:center;
  opacity:0;pointer-events:none;transition:opacity .25s ease}
.modal-overlay.show{opacity:1;pointer-events:auto}
.modal{background:var(--panel-solid);border:1px solid var(--line);border-radius:20px;
  padding:36px;width:100%;max-width:380px;box-shadow:var(--shadow-lg);
  transform:scale(.92) translateY(10px);transition:transform .3s cubic-bezier(.4,0,.2,1)}
.modal-overlay.show .modal{transform:scale(1) translateY(0)}
.modal h2{font-size:20px;font-weight:700;margin-bottom:4px;
  background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.modal p{color:var(--dim);font-size:13px;margin-bottom:20px}
.modal .field{margin-bottom:14px}
.modal label{display:block;font-size:11.5px;color:var(--dim);margin-bottom:5px;
  text-transform:uppercase;letter-spacing:.5px;font-weight:600}
.modal input{width:100%}
.modal button.act{width:100%;padding:11px;margin-top:6px;font-size:14px}
.modal .close-btn{position:absolute;top:14px;right:14px;background:none;border:none;
  color:var(--dim);font-size:18px;cursor:pointer;transition:var(--transition)}
.modal .close-btn:hover{color:var(--text)}

/* ── counter animation ───────────────────────────────────────────────── */
@keyframes countUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.count-anim{animation:countUp .5s cubic-bezier(.4,0,.2,1) both}

/* ── stagger children ────────────────────────────────────────────────── */
.stagger > *{opacity:0;animation:fadeSlideIn .4s cubic-bezier(.4,0,.2,1) both}
.stagger > *:nth-child(1){animation-delay:.05s}
.stagger > *:nth-child(2){animation-delay:.1s}
.stagger > *:nth-child(3){animation-delay:.15s}
.stagger > *:nth-child(4){animation-delay:.2s}
.stagger > *:nth-child(5){animation-delay:.25s}
.stagger > *:nth-child(6){animation-delay:.3s}
.stagger > *:nth-child(7){animation-delay:.35s}
.stagger > *:nth-child(8){animation-delay:.4s}
.stagger > *:nth-child(9){animation-delay:.45s}

/* ── map zone hover ──────────────────────────────────────────────────── */
.zone-label{font-size:2.6px;fill:#9db1dd;transition:fill .2s}
.zone-poly{transition:fill .3s ease, stroke .3s ease;cursor:pointer}
.zone-poly:hover{fill-opacity:.85;stroke:#6c8cff;stroke-width:1}
.cam-dot{transition:r .2s ease;cursor:pointer}
.cam-dot:hover{r:3}

/* ── scrollbar ───────────────────────────────────────────────────────── */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--muted);border-radius:4px}

/* ── responsive ──────────────────────────────────────────────────────── */
@media(max-width:768px){
  header{padding:0 12px;gap:8px}
  header h1{font-size:14px}
  nav button{padding:5px 10px;font-size:11.5px}
  main{padding:12px}
  .grid{grid-template-columns:1fr}
  .grid-2{grid-template-columns:1fr}
  .stat .num{font-size:32px}
}

/* ── floating action glow ────────────────────────────────────────────── */
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
.float{animation:float 3s ease-in-out infinite}

/* ── progress ring ───────────────────────────────────────────────────── */
.ring{transform:rotate(-90deg)}
.ring circle{transition:stroke-dashoffset .8s cubic-bezier(.4,0,.2,1)}
</style>
</head>
<body>

<header>
  <h1>StoreSight</h1>
  <nav id="nav"></nav>
  <div id="who">
    <div class="avatar" id="avatar" style="display:none"></div>
    <span id="who-text">not signed in</span>
  </div>
</header>

<main id="view"></main>
<div id="toasts"></div>

<!-- Login Modal -->
<div class="modal-overlay" id="loginModal">
  <div class="modal" style="position:relative">
    <button class="close-btn" onclick="closeLogin()">&times;</button>
    <h2>Welcome back</h2>
    <p>Sign in to access the operations dashboard</p>
    <div class="field">
      <label>Username</label>
      <input type="text" id="loginUser" placeholder="admin, op1, manager, viewer" autocomplete="username"/>
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="loginPass" placeholder="Enter password" autocomplete="current-password"/>
    </div>
    <button class="act" onclick="submitLogin()">Sign In</button>
  </div>
</div>

<script>
"use strict";
const $ = q => document.querySelector(q);
const api = {
  token: sessionStorage.getItem("token") || "",
  role: sessionStorage.getItem("role") || "view_only",
  user: sessionStorage.getItem("user") || "",
};

/* ── fetch helper ─────────────────────────────────────────────────────── */
async function call(path, opts={}) {
  const r = await fetch(path, {...opts,
    headers: {"Content-Type":"application/json",
              ...(api.token?{"Authorization":"Bearer "+api.token}:{}) , ...(opts.headers||{})}});
  if (!r.ok) throw new Error((await r.json().catch(()=>({}))).detail || r.status);
  return r.json();
}
const esc = s => String(s??"").replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const pill = (v,cls) => `<span class="pill ${cls}">${esc(v)}</span>`;
function level(v){ return v==="urgent"||v==="high" ? "bad" : v==="medium" ? "warn" : "ok"; }

/* ── toast ────────────────────────────────────────────────────────────── */
function toast(msg, type="info", ms=3500) {
  const el = document.createElement("div");
  el.className = `toast ${type}`;
  el.textContent = msg;
  $("#toasts").appendChild(el);
  setTimeout(()=>{ el.classList.add("out"); setTimeout(()=>el.remove(), 300); }, ms);
}

/* ── animated counter ─────────────────────────────────────────────────── */
function animateNum(el, target, dur=800) {
  const start = performance.now();
  const from = 0;
  function tick(now) {
    const t = Math.min((now - start) / dur, 1);
    const ease = 1 - Math.pow(1 - t, 3);
    el.textContent = Math.round(from + (target - from) * ease);
    if (t < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

/* ── skeleton helpers ─────────────────────────────────────────────────── */
const skelCards = (n=4) => `<div class="grid stagger">${Array(n).fill(
  '<div class="card"><div class="skeleton skel-line" style="width:40%"></div><div class="skeleton skel-box"></div></div>'
).join("")}</div>`;

/* ── progress ring SVG ────────────────────────────────────────────────── */
function ringSvg(pct, size=80, stroke=6, color="var(--accent)") {
  const r = (size - stroke) / 2;
  const circ = 2 * Math.PI * r;
  const offset = circ * (1 - pct / 100);
  return `<svg width="${size}" height="${size}" class="ring">
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="var(--line)" stroke-width="${stroke}"/>
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="${stroke}"
      stroke-linecap="round" stroke-dasharray="${circ}" stroke-dashoffset="${offset}"/>
  </svg>`;
}

/* ═══════════════════════════════════════════════════════════════════════ */
/*  VIEWS                                                                 */
/* ═══════════════════════════════════════════════════════════════════════ */
const views = {};

/* ── overview ─────────────────────────────────────────────────────────── */
views.overview = async () => {
  const boot = await call("/api/v1/dashboard/bootstrap");
  const healthy = boot.cameras.filter(c=>c.status==="active").length;
  const pct = boot.cameras.length ? Math.round(healthy / boot.cameras.length * 100) : 0;
  return `
  <div class="grid stagger" style="margin-bottom:16px">
    <div class="card stat glow-accent">
      <h3><span class="icon">📹</span>Cameras Live</h3>
      <div style="display:flex;align-items:center;justify-content:center;gap:16px">
        ${ringSvg(pct, 72, 5, "var(--ok)")}
        <div><div class="num solid count-anim" data-count="${healthy}">${healthy}</div>
        <div class="label">of ${boot.cameras.length} online</div></div>
      </div>
    </div>
    <div class="card stat glow-accent">
      <h3><span class="icon">🗺️</span>Zones Mapped</h3>
      <div class="num count-anim" data-count="${boot.zones.length}">${boot.zones.length}</div>
      <div class="label">active zones</div>
    </div>
    <div class="card stat glow-ok">
      <h3><span class="icon">🛡️</span>System Health</h3>
      <div style="display:flex;align-items:center;justify-content:center;gap:16px">
        ${ringSvg(pct, 72, 5, pct > 80 ? "var(--ok)" : pct > 50 ? "var(--warn)" : "var(--bad)")}
        <div><div class="num solid count-anim" data-count="${pct}">${pct}</div>
        <div class="label">percent uptime</div></div>
      </div>
    </div>
    <div class="card">
      <h3><span class="icon">⚡</span>Quick Actions</h3>
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px">
        <button class="act ghost" onclick="go('alerts')">Review Queue →</button>
        <button class="act ghost" onclick="go('map')">Store Map →</button>
        <button class="act ghost" onclick="go('analytics')">Analytics →</button>
      </div>
    </div>
  </div>
  <div class="card" style="margin-top:16px">
    <h3><span class="icon">📊</span>Camera Status Overview</h3>
    <table>
      <thead><tr><th>Camera</th><th>Status</th><th>Health</th></tr></thead>
      <tbody>${boot.cameras.map(c=>`<tr>
        <td><span class="pulse ${c.status==='active'?'live':'warn-dot'}"></span>${esc(c.name)}</td>
        <td>${pill(c.status, c.status==="active"?"ok":"warn")}</td>
        <td>${c.status==='active'?'<span style="color:var(--ok)">●</span>':'<span style="color:var(--warn)">●</span>'} ${c.status==='active'?'Healthy':'Degraded'}</td>
      </tr>`).join("")}</tbody>
    </table>
  </div>`;
};

/* ── cameras ──────────────────────────────────────────────────────────── */
views.cameras = async () => {
  const boot = await call("/api/v1/dashboard/bootstrap");
  const rows = boot.cameras.map(c=>`
    <tr>
      <td><span class="pulse ${c.status==='active'?'live':'warn-dot'}"></span>${esc(c.name)}</td>
      <td>${pill(c.status, c.status==="active"?"ok":"warn")}</td>
      <td class="dim">${c.map_x ?? "–"}, ${c.map_y ?? "–"}</td>
      <td class="dim">FOV ${c.fov ?? "–"}° @ ${c.facing ?? "–"}°</td>
    </tr>`).join("");
  return `<div class="card"><h3><span class="icon">📹</span>Live Cameras</h3><table>
    <thead><tr><th>Name</th><th>Status</th><th>Position</th><th>Optics</th></tr></thead>
    <tbody>${rows}</tbody></table>
    <p class="dim" style="margin-top:12px;font-size:12px">Bounding-box overlay streams via Phase 5/6 services. Stats refresh from /dashboard/bootstrap.</p></div>`;
};

/* ── map ──────────────────────────────────────────────────────────────── */
views.map = async () => {
  const boot = await call("/api/v1/dashboard/bootstrap");
  let heat = [];
  try { const h = await fetch("/api/v1/analytics/heatmap").then(r=>r.json());
        heat = (h.cells||[]).filter(c=>c.intensity>0); } catch(e){}
  const W=100,H=150;
  const poly = z => z.polygon.map(p=>`${(+p.x).toFixed(1)},${(+p.y).toFixed(1)}`).join(" ");
  const zonesSvg = boot.zones.map(z=>{
    const restricted = z.type==="restricted";
    return `<polygon class="zone-poly" points="${poly(z)}" fill="${restricted?"rgba(90,42,51,.6)":"rgba(34,48,77,.6)"}"
      stroke="#4a6090" stroke-width=".6"/>`+
      `<text class="zone-label" x="${z.polygon.reduce((s,p)=>s+ +p.x,0)/Math.max(1,z.polygon.length)}"
             y="${z.polygon.reduce((s,p)=>s+ +p.y,0)/Math.max(1,z.polygon.length)}"
             text-anchor="middle">${esc(z.name)}</text>`;
  }).join("");
  const heatSvg = heat.map(c=>`<circle cx="${c.x}" cy="${c.y}" r="${2+Math.min(6,c.intensity)}"
      fill="url(#heatGrad)" opacity=".45"/>`).join("");
  const camSvg = boot.cameras.filter(c=>c.map_x!=null).map(c=>`
    <g><circle class="cam-dot" cx="${c.map_x}" cy="${c.map_y}" r="1.8"
       fill="${c.status==="active"?"var(--ok)":"var(--warn)"}"/>
    <text x="${+c.map_x+2.6}" y="${+c.map_y+1}" fill="#8fa0c5" font-size="2.2">${esc(c.name)}</text></g>`).join("");
  return `<div class="card"><h3><span class="icon">🗺️</span>Store Map · Heatmap Overlay</h3>
    <svg class="map" viewBox="-2 -4 ${W+4} ${H+8}">
      <defs>
        <radialGradient id="heatGrad"><stop offset="0%" stop-color="#ff6b35" stop-opacity=".8"/>
        <stop offset="100%" stop-color="#ff6b35" stop-opacity="0"/></radialGradient>
      </defs>
      ${zonesSvg}${heatSvg}${camSvg}
    </svg>
    <p class="dim" style="margin-top:10px;font-size:12px">Polygons from GET /stores/{id}/zones · circles = tracked intensity · dots = cameras</p></div>`;
};

/* ── alerts ───────────────────────────────────────────────────────────── */
views.alerts = async () => {
  let alerts=[];
  try { alerts = await call("/api/v1/dashboard/alerts"); }
  catch(e){ return `<div class="card bad" style="border-color:rgba(248,113,113,.3)">Alerts require a signed-in role with evidence access. Use login (top-right).</div>`; }
  const row = a => `
    <tr>
      <td style="font-weight:600">#${a.id}</td>
      <td>${pill(a.priority, level(a.priority))}</td>
      <td>${pill(a.status, a.status==="open"?"warn":a.status==="resolved"?"ok":"dim")}</td>
      <td class="dim">${esc(a.instance_key||"—")}</td>
      <td class="dim">${(a.confidence??"")&&Number(a.confidence).toFixed(2)}</td>
      <td class="dim" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(a.rules||[])[0]?esc(a.rules[0]).slice(0,80)+"…":"—"}</td>
      <td><div style="display:flex;gap:4px;flex-wrap:wrap">
        <button class="act ghost" onclick="alertAction(${a.id},'claim')">Claim</button>
        <button class="act" onclick="alertAction(${a.id},'resolve')">Resolve</button>
        <button class="act danger" onclick="alertAction(${a.id},'false_positive')">FP</button>
      </div></td></tr>`;
  return `<div class="card"><h3><span class="icon">🔔</span>Review Queue</h3><table>
    <thead><tr><th>ID</th><th>Priority</th><th>Status</th><th>Item</th><th>Conf</th><th>Rule</th><th>Actions</th></tr></thead>
    <tbody>${alerts.map(row).join("") || '<tr><td colspan="7" class="dim" style="text-align:center;padding:24px">No alerts yet.</td></tr>'}</tbody></table></div>`;
};
window.alertAction = async (id, action) => {
  try {
    await call(`/api/v1/dashboard/alerts/${id}/action?action=${action}&user=${api.user}`, {method:"POST"});
    toast(`Alert #${id} ${action.replace("_"," ")}d`, "success");
    go("alerts");
  } catch(e){ toast(e.message, "error"); }
};

/* ── journeys ─────────────────────────────────────────────────────────── */
views.journeys = async () => {
  setTimeout(()=>{
    const inp = document.getElementById("jkey");
    if(inp) inp.addEventListener("keydown", async e=>{
      if(e.key!=="Enter")return;
      const out=document.getElementById("jout");
      out.textContent = "Loading…";
      try{ const tl=await call("/api/v1/journeys/"+encodeURIComponent(e.target.value)+"/timeline");
           out.textContent = tl.length? tl.map(t=>`${t.position}. ${t.label} (${t.ts||"—"}), conf ${t.confidence??"—"}`).join("\n")
                                      : "No timeline for this key"; }
      catch(err){ out.textContent = "Error: "+err.message; }
    });
  }, 0);
  return `<div class="card"><h3><span class="icon">🧭</span>Journeys Timeline</h3>
    <input type="text" id="jkey" placeholder='Enter instance_key (e.g. "cam:A123") — press Enter' style="margin-bottom:12px"/>
    <pre class="log" id="jout">Type a key and press Enter…</pre></div>`;
};

/* ── analytics ────────────────────────────────────────────────────────── */
views.analytics = async () => {
  let heat={cells:[]};
  try{ heat=await fetch("/api/v1/analytics/heatmap").then(r=>r.json()); }catch(e){}
  const cells=(heat.cells||[]).filter(c=>c.intensity>0)
     .sort((a,b)=>b.intensity-a.intensity).slice(0,10);
  const maxI = cells.length ? cells[0].intensity : 1;
  const rows = cells.map(c=>{
    const barW = Math.round((c.intensity / maxI) * 100);
    return `<tr>
      <td class="dim">(${c.x}, ${c.y})</td>
      <td style="width:50%"><div style="background:var(--line2);border-radius:4px;height:8px;overflow:hidden">
        <div style="height:100%;width:${barW}%;background:var(--grad);border-radius:4px;transition:width .6s ease"></div></div></td>
      <td style="font-weight:600;text-align:right">${c.intensity}</td></tr>`;
  }).join("");
  return `<div class="card"><h3><span class="icon">📈</span>Heatmap — Top Cells</h3>
    <table><thead><tr><th>Position</th><th>Intensity</th><th style="text-align:right">Count</th></tr></thead>
    <tbody>${rows || '<tr><td colspan="3" class="dim">No data.</td></tr>'}</tbody></table></div>`;
};

/* ── inventory & safety ───────────────────────────────────────────────── */
views.inventory = async () => {
  setTimeout(async()=>{
    const el = document.getElementById("safe");
    if(!el) return;
    try{
      const evs=await call("/api/v1/events?limit=20");
      const filtered = evs.filter(e=>/fall|restricted|abandoned|congestion|misplaced|mismatch/.test(e.event_type));
      el.textContent = filtered.length
        ? filtered.map(e=>`${e.event_timestamp.slice(11,19)}  ${e.event_type}`).join("\n")
        : "No safety events yet";
    } catch(e){ el.textContent="Error: "+e.message; }
  }, 0);
  return `<div class="card"><h3><span class="icon">🛡️</span>Safety & Inventory Feed</h3>
    <pre class="log" id="safe">Listening…</pre></div>`;
};

/* ── assistant ────────────────────────────────────────────────────────── */
views.assistant = async () => {
  setTimeout(()=>{
    const inp = document.getElementById("q");
    if(inp) inp.addEventListener("keydown", e=>{ if(e.key==="Enter") ask(); });
  }, 0);
  return `<div class="card"><h3><span class="icon">🤖</span>Investigation Assistant</h3>
    <div style="display:flex;gap:8px;margin-bottom:12px">
      <input id="q" type="text" placeholder='try: "why was alert #A-1 flagged?"'/>
      <button class="act" onclick="ask()">Ask</button></div>
    <pre class="log" id="aout" style="min-height:100px">Ask a question about the data…</pre></div>`;
};
window.ask = async ()=>{
  const q = document.getElementById("q").value;
  const out = document.getElementById("aout");
  if(!q.trim()) return;
  out.textContent = "Thinking…";
  try{
    const r=await call("/api/v1/reports/assistant",{method:"POST",body:JSON.stringify({question:q})});
    out.textContent = r.declined ? ("Declined: "+r.reason) : (r.answer||"(empty)");
  } catch(e){ out.textContent = "Error: "+e.message; }
};

/* ── admin ────────────────────────────────────────────────────────────── */
views.admin = async () => {
  if(!["org_admin","super_admin"].includes(api.role))
    return `<div class="card" style="border-color:rgba(248,113,113,.3)"><h3>🔒 Admin Area</h3>
      <p style="color:var(--bad)">Admin area requires an admin role.</p></div>`;
  let log=[];
  try{ log=await call("/api/v1/audit-log"); }catch(e){}
  return `<div class="card"><h3><span class="icon">📋</span>Audit Log</h3><pre class="log">${
    log.map(l=>`${new Date(l.ts*1000).toISOString().slice(11,19)}  ${l.actor}  ${l.action}  ${l.entity_type}#${l.entity_id}`).join("\n")
    || "(empty)"}</pre></div>`;
};

/* ═══════════════════════════════════════════════════════════════════════ */
/*  SHELL                                                                 */
/* ═══════════════════════════════════════════════════════════════════════ */
const NAV=[["overview","Overview"],["cameras","Cameras"],["map","Map"],["alerts","Alerts"],
           ["journeys","Journeys"],["analytics","Analytics"],["inventory","Inventory"],
           ["assistant","Assistant"],["admin","Admin"]];

function renderNav(){
  $("#nav").innerHTML = NAV.map(([k,label])=>
    `<button data-k="${k}" onclick="go('${k}')">${label}</button>`).join("")
    + (api.token ? "" : `<button onclick="openLogin()">Sign In</button>`);
}

function updateUserBadge(){
  const avatar = $("#avatar");
  const text = $("#who-text");
  if(api.token){
    avatar.style.display="grid";
    avatar.textContent = api.user.charAt(0).toUpperCase();
    text.textContent = `${api.user} · ${api.role}`;
  } else {
    avatar.style.display="none";
    text.textContent = "not signed in";
  }
}

window.go = async (k)=>{
  document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("active", b.dataset.k===k));
  const main = $("#view");
  main.innerHTML = skelCards(3);
  main.classList.remove("view-enter");
  void main.offsetWidth;
  try {
    main.innerHTML = await views[k]();
    main.classList.add("view-enter");
  } catch(e){
    main.innerHTML = `<div class="card" style="border-color:rgba(248,113,113,.3)">
      <h3 style="color:var(--bad)">Error</h3><p>${esc(e.message)}</p></div>`;
    main.classList.add("view-enter");
  }
};

/* ── login modal ──────────────────────────────────────────────────────── */
window.openLogin = ()=>{
  const m = $("#loginModal");
  m.classList.add("show");
  setTimeout(()=>$("#loginUser").focus(), 100);
};
window.closeLogin = ()=>{
  const m = $("#loginModal");
  m.classList.remove("show");
};
window.submitLogin = async ()=>{
  const u = $("#loginUser").value.trim();
  const p = $("#loginPass").value;
  if(!u){ toast("Enter a username", "error"); return; }
  try{
    const r = await call("/api/v1/auth/login",{method:"POST",body:JSON.stringify({username:u,password:p})});
    api.token=r.access_token; api.role=r.role; api.user=u;
    sessionStorage.setItem("token",r.access_token);
    sessionStorage.setItem("role",r.role);
    sessionStorage.setItem("user",u);
    closeLogin();
    updateUserBadge();
    renderNav();
    toast(`Welcome, ${u}!`, "success");
    go("overview");
  } catch(e){ toast("Login failed: "+e.message, "error"); }
};
$("#loginModal").addEventListener("click", e=>{ if(e.target.classList.contains("modal-overlay")) closeLogin(); });
document.addEventListener("keydown", e=>{ if(e.key==="Escape") closeLogin(); });

/* ── init ─────────────────────────────────────────────────────────────── */
updateUserBadge();
renderNav();
go("overview");
setInterval(()=>{ if(location.hash==="#alerts") go("alerts"); }, 15000);
</script>
</body>
</html>
